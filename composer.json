{
    "name": "alt-design/alt-google-maps",
    "description": "Location picker fieldtype for Statamic with Google Maps or OpenStreetMap, storing latitude, longitude, zoom and address, with Antlers tags for the front end.",
    "type": "statamic-addon",
    "keywords": [
        "statamic",
        "statamic-addon",
        "google-maps",
        "openstreetmap",
        "maps",
        "fieldtype",
        "location"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Alt Design",
            "homepage": "https://alt-design.net"
        }
    ],
    "support": {
        "issues": "https://github.com/alt-design/Alt-google-maps-addon/issues"
    },
    "require": {
        "php": "^8.2",
        "statamic/cms": "^6.40"
    },
    "require-dev": {
        "orchestra/testbench": "^10.8",
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "AltDesign\\AltGoogleMapsAddon\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AltDesign\\AltGoogleMapsAddon\\Tests\\": "tests"
        }
    },
    "extra": {
        "statamic": {
            "name": "Alt Google Maps",
            "description": "Location picker fieldtype for Google Maps or OpenStreetMap, with Antlers tags."
        },
        "laravel": {
            "providers": [
                "AltDesign\\AltGoogleMapsAddon\\ServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true,
            "pestphp/pest-plugin": true
        },
        "optimize-autoloader": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
